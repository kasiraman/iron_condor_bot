# Copy this file to .env and fill in your Alpaca keys.
#
# ALPACA_PAPER controls which account these scripts trade against. Defaults to paper
# (true) if unset -- you must explicitly set it to false to trade real money. Simple
# setup: just fill in ALPACA_API_KEY/ALPACA_SECRET_KEY below with whichever account's
# keys match your current ALPACA_PAPER setting, and swap them + flip ALPACA_PAPER when
# you're ready to switch. Safer setup (lets you keep both configured and flip freely
# without re-editing keys): fill in ALPACA_PAPER_API_KEY/ALPACA_PAPER_SECRET_KEY and
# ALPACA_LIVE_API_KEY/ALPACA_LIVE_SECRET_KEY instead -- these take priority over the
# plain ALPACA_API_KEY/ALPACA_SECRET_KEY for whichever mode is active.
ALPACA_PAPER=true

ALPACA_API_KEY=your_paper_api_key_here
ALPACA_SECRET_KEY=your_paper_secret_key_here
# ALPACA_PAPER_API_KEY=
# ALPACA_PAPER_SECRET_KEY=
# ALPACA_LIVE_API_KEY=
# ALPACA_LIVE_SECRET_KEY=

# Shared account-level settings -- used by both strategies (0dte_* and weekend_*)
# UNDERLYING=SPY
# RISK_FREE_RATE=0.05
# STOCK_DATA_FEED=iex        # entry bots default to iex (free-tier); settle scripts default to sip
# OPTION_DATA_FEED=indicative

# =====================================================================================
# 0DTE strategy (0dte_iron_condor_bot.py / 0dte_monitor_and_exit.py / 0dte_settle_trades.py)
# =====================================================================================
# EM_MULTIPLIER=1.25
# WING_FRACTION=0.5
# QTY=1                      # ceiling on contracts/leg -- actual qty is sized down to fit the risk budget below

# Data-driven alternative to manually toggling EM_MULTIPLIER by hand -- see
# em_multiplier_calibration.py and the README's "Data-driven EM multiplier" section
# before enabling. Defaults to "fixed" (uses EM_MULTIPLIER above, unchanged). Test with
# --dry-run (and ideally a stretch of paper trading) before setting this to "calibrated"
# on a live account.
# EM_MULTIPLIER_MODE=fixed              # "fixed" or "calibrated"
# EM_MULTIPLIER_TARGET_PERCENTILE=95    # historically, only this-many-percent of days should breach the resulting strikes
# EM_MULTIPLIER_LOOKBACK_DAYS=730       # ~2 years of history to backtest against
# EM_MULTIPLIER_VOL_WINDOW=20           # trailing days used to estimate each historical day's "predicted move"
# EM_MULTIPLIER_MIN_SAMPLES=20          # below this, fall back (pooled, then fixed) rather than trust a thin sample
# STRIKE_RANGE_PCT=0.08
# CREDIT_BUFFER=0.05

# Per-trade risk budget -- set a dollar amount, a percent of account equity, or both.
# qty = floor(risk_budget / risk-per-contract), capped at QTY. If both are set, the
# dollar amount is used as a hard ceiling on the percent-of-equity amount (whichever is
# LOWER wins) -- e.g. "risk 2% of the account, but never more than $1,000". If neither
# is set, defaults to a flat $500.
# MAX_RISK_PER_TRADE_USD=500
# MAX_RISK_PER_TRADE_PCT=0.02   # fraction of account equity, e.g. 0.02 = 2% (pulled live from Alpaca)

# 0dte_monitor_and_exit.py overrides
# PROFIT_TARGET_PCT=0.80
# STOP_LOSS_PCT=1.20
# PROFIT_CLOSE_BUFFER=0.02
# STOP_LOSS_BUFFER=0.10
# MONITOR_END_TIME=15:55
# PENDING_CLOSE_TIMEOUT_MIN=10
# RESUBMIT_BUFFER_STEP=0.05
# MAX_ESCALATIONS=5

# =====================================================================================
# Weekend (Friday->Monday) strategy (weekend_iron_condor_bot.py / weekend_monitor_and_exit.py
# / weekend_settle_trades.py) -- entirely separate config from the 0DTE strategy above, so
# the two can be sized/tuned independently. See weekend_time.py and the README's "Weekend
# strategy" section for the dual calendar-T/trading-hours-T rationale behind this strategy.
# =====================================================================================
# WEEKEND_EM_MULTIPLIER=1.5   # wider than the 0DTE default on purpose -- see weekend_iron_condor_bot.py
# WEEKEND_WING_FRACTION=0.5
# WEEKEND_QTY=1               # ceiling on contracts/leg, same semantics as QTY above
# WEEKEND_STRIKE_RANGE_PCT=0.08
# WEEKEND_CREDIT_BUFFER=0.05
# WEEKEND_MIN_GAP_DAYS=2       # minimum calendar-day gap to the next session for this to trigger as a "weekend" entry

# Historical weekend/holiday gap buffer -- widens strikes using REAL historical SPY
# close-to-next-open jumps (combined in quadrature with the trading-hours EM component),
# instead of relying on trading-hours EM alone. See weekend_iron_condor_bot.py's
# estimate_weekend_gap_em() and the README's "Weekend EM: the gap-risk buffer" section.
# WEEKEND_GAP_BUFFER_ENABLED=true
# WEEKEND_GAP_LOOKBACK_DAYS=730   # ~2 years of history to estimate the gap distribution from
# WEEKEND_GAP_MIN_SAMPLES=20      # below this many observed gaps, skip the buffer rather than trust a thin sample

# Separate risk budget bucket from the 0DTE strategy's MAX_RISK_PER_TRADE_USD/PCT above --
# same dollar-ceiling-over-percent resolution logic; defaults to a flat $500 if neither is set.
# WEEKEND_MAX_RISK_PER_TRADE_USD=500
# WEEKEND_MAX_RISK_PER_TRADE_PCT=0.02

# weekend_monitor_and_exit.py overrides -- same semantics as the 0DTE monitor's vars above,
# just independently tunable. Only meaningful during the EXPIRATION day's market hours
# (e.g. Monday) -- this monitor should not be scheduled to run over the weekend itself.
# WEEKEND_PROFIT_TARGET_PCT=0.80
# WEEKEND_STOP_LOSS_PCT=1.20
# WEEKEND_PROFIT_CLOSE_BUFFER=0.02
# WEEKEND_STOP_LOSS_BUFFER=0.10
# WEEKEND_MONITOR_END_TIME=15:55
# WEEKEND_PENDING_CLOSE_TIMEOUT_MIN=10
# WEEKEND_RESUBMIT_BUFFER_STEP=0.05
# WEEKEND_MAX_ESCALATIONS=5

# =====================================================================================
# Swing (multi-week) strategy (swing_iron_condor_bot.py / swing_monitor_and_exit.py /
# swing_settle_trades.py) -- entirely separate config, so it can be sized/tuned
# independently. Targets SWING_TARGET_DTE calendar days out (try 45, or 21 to compare --
# these are two settings to experiment with independently, not a combined "enter at 45,
# exit at 21" rule). See the README's "Swing strategy" section.
# =====================================================================================
# SWING_TARGET_DTE=45          # try 21 to compare -- change this and re-run to test a different DTE
# SWING_EXPIRATION_WINDOW_DAYS=7   # how far to search around the target for a real listed expiration
# SWING_EM_MULTIPLIER=1.25
# SWING_WING_FRACTION=0.5
# SWING_QTY=1                  # ceiling on contracts/leg, same semantics as QTY above
# SWING_STRIKE_RANGE_PCT=0.15  # wider than 0DTE/weekend on purpose -- EM is a much bigger fraction of spot at 45 DTE
# SWING_CREDIT_BUFFER=0.05

# Separate risk budget bucket, same dollar-ceiling-over-percent resolution as the other
# strategies; defaults to a flat $500 if neither is set.
# SWING_MAX_RISK_PER_TRADE_USD=500
# SWING_MAX_RISK_PER_TRADE_PCT=0.02

# swing_monitor_and_exit.py overrides -- defaults are intentionally DIFFERENT from the
# 0DTE/weekend monitors (50%/200% instead of 80%/120%), since a slower-decaying position
# commonly gets managed sooner relative to max profit. See the README.
# SWING_PROFIT_TARGET_PCT=0.50
# SWING_STOP_LOSS_PCT=2.00
# SWING_PROFIT_CLOSE_BUFFER=0.02
# SWING_STOP_LOSS_BUFFER=0.10
# SWING_MONITOR_END_TIME=15:55
# SWING_PENDING_CLOSE_TIMEOUT_MIN=10
# SWING_RESUBMIT_BUFFER_STEP=0.05
# SWING_MAX_ESCALATIONS=5

# Logging (bot_logging.py) overrides -- applies to every script, all three strategies
# LOG_LEVEL=INFO
# LOG_ROTATE_DAYS=30
# LOG_BACKUP_COUNT=6
