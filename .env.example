# Copy this file to .env and fill in your Alpaca PAPER trading keys
# (Dashboard -> Paper Trading -> API Keys. Do NOT use live-account keys here.)
ALPACA_API_KEY=your_paper_api_key_here
ALPACA_SECRET_KEY=your_paper_secret_key_here

# Optional overrides (defaults shown)
# UNDERLYING=SPY
# EM_MULTIPLIER=1.25
# WING_FRACTION=0.5
# QTY=1                      # ceiling on contracts/leg -- actual qty is sized down to fit the risk budget below
# RISK_FREE_RATE=0.05
# STRIKE_RANGE_PCT=0.08

# Per-trade risk budget -- set a dollar amount, a percent of account equity, or both.
# qty = floor(risk_budget / risk-per-contract), capped at QTY. If both are set, the
# dollar amount is used as a hard ceiling on the percent-of-equity amount (whichever is
# LOWER wins) -- e.g. "risk 2% of the account, but never more than $1,000". If neither
# is set, defaults to a flat $500.
# MAX_RISK_PER_TRADE_USD=500
# MAX_RISK_PER_TRADE_PCT=0.02   # fraction of account equity, e.g. 0.02 = 2% (pulled live from Alpaca)
# CREDIT_BUFFER=0.05

# Exit-management monitor (monitor_and_exit.py) overrides
# PROFIT_TARGET_PCT=0.80
# STOP_LOSS_PCT=1.20
# PROFIT_CLOSE_BUFFER=0.02
# STOP_LOSS_BUFFER=0.10
# MONITOR_END_TIME=15:55
# PENDING_CLOSE_TIMEOUT_MIN=10
# RESUBMIT_BUFFER_STEP=0.05
# MAX_ESCALATIONS=5

# Logging (bot_logging.py) overrides -- applies to all four scripts
# LOG_LEVEL=INFO
# LOG_ROTATE_DAYS=30
# LOG_BACKUP_COUNT=6
